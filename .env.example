# Chollo & Glam — Asistente IA (RAG) · Variables de entorno
# Copia este archivo a .env (local) o configúralas en Vercel → Settings → Environment Variables.
# NUNCA hagas commit del .env real.

# --- Supabase (Project Settings → API) ---
# Project URL (pública)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# service_role key (SECRETA — bypass RLS, solo server-side)
SUPABASE_SERVICE_KEY=eyJ...service_role...

# --- Autenticación de la API ---
# Clave para /api/ingest y /api/documents. Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# --- Proveedor de IA ---
# gemini  → Google Gemini, FREE TIER sin tarjeta (RECOMENDADO, por defecto)
# openai  → OpenAI (de pago)
# ollama  → servidor local (solo desarrollo)
AI_PROVIDER=gemini

# Clave de Google AI Studio — GRATIS en https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...

# Solo si usas OpenAI:
# OPENAI_API_KEY=sk-...
# Solo para Ollama o endpoints personalizados:
# AI_BASE_URL=http://localhost:11434/v1

# --- Modelos (defaults según proveedor; solo sobreescribe si sabes qué haces) ---
# gemini:  embedding gemini-embedding-001 (768d con dimensions=768) · chat gemini-2.5-flash
# openai:  embedding text-embedding-3-small (1536d) · chat gpt-4o-mini
# ollama:  embedding nomic-embed-text (768d) · chat llama3.1
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# CHAT_MODEL=gemini-2.5-flash

# --- CORS (origen de la tienda; para local añade http://localhost:4321) ---
ALLOWED_ORIGINS=http://localhost:4321

# --- Rate limiting ---
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_S=60
